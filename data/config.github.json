{
  "ai": {
    "provider": "openai",
    "model": "deepseek-v4.1-flash",
    "api_key_env": "OPENAI_API_KEY",
    "base_url": "https://api.a6api.com/v1",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 3,
    "enrichment_concurrency": 3,
    "languages": ["zh", "en"]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 6.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 6.5,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 150,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison's Weblog",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "Hacker News Front Page",
        "url": "https://hnrss.org/frontpage?points=200",
        "enabled": true,
        "category": "tech",
        "profile": "tech-news"
      },
      {
        "name": "The Verge",
        "url": "https://www.theverge.com/rss/index.xml",
        "enabled": true,
        "category": "tech",
        "profile": "tech-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Ars Technica",
        "url": "https://feeds.arstechnica.com/arstechnica/index",
        "enabled": true,
        "category": "tech",
        "profile": "tech-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "CoinDesk",
        "url": "https://www.coindesk.com/arc/outboundfeeds/rss/",
        "enabled": true,
        "category": "crypto",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Cointelegraph",
        "url": "https://cointelegraph.com/rss",
        "enabled": true,
        "category": "crypto",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "The Block",
        "url": "https://www.theblock.co/rss.xml",
        "enabled": true,
        "category": "crypto",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "CNBC Finance",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Sean Goedecke",
        "url": "https://www.seangoedecke.com/rss.xml",
        "enabled": true,
        "category": "software-engineering",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50,
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50,
          "profile": "tech-news"
        },
        {
          "subreddit": "CryptoCurrency",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 100,
          "profile": "finance-news"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "github": [
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": true,
        "category": "tooling",
        "profile": "tech-news"
      }
    ]
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 25,
    "profile_order": [
      "tech-news",
      "finance-news",
      "tech-blog"
    ],
    "category_groups": {
      "ai": {
        "limit": 8,
        "categories": ["ai-tools", "llm-inference", "machine-learning"]
      },
      "crypto": {
        "limit": 6,
        "categories": ["crypto"]
      }
    },
    "default_group": "other",
    "default_group_limit": 5
  }
}
